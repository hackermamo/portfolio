# =========================================================
#  Environment Variables — copy this file to .env and fill
# =========================================================

# Supabase / PostgreSQL cloud connection string
# Direct: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler (recommended for serverless): postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Strong random secret for JWT signing (min 32 chars)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Admin account that gets created on first seed
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=YourStrongPassword123
